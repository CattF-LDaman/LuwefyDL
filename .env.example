# Copy to .env and adjust for local/docker-compose use

# Set to 1 when running in Docker (set automatically in Dockerfile)
# DOCKER=1

# Where imported tracks are saved (Artist/Album layout)
# Local dev:
# MUSIC_LIBRARY_PATH=./data/music
#
# Docker: path inside the container (must match the volume mount target)
# MUSIC_LIBRARY_PATH=/data/music
# Host folder bind-mounted to MUSIC_LIBRARY_PATH (any absolute path on the host)
# MUSIC_HOST_PATH=./data/music

# Web UI bind address and port
# HOST=127.0.0.1
# PORT=8080

# Open browser on startup (disable in Docker/headless)
# SHOW_BROWSER=true

# Download and processing scratch space
# TEMP_DIR=./temp

# Logging: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Docker: ownership for bind-mounted library and temp dirs (default 1000:1000)
# PUID=1000
# PGID=1000
# TEMP_HOST_PATH=./temp
